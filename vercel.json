{
  "crons": [
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/lesson-outcomes",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/lesson-reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
